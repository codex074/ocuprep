# Patient-name lookup (src/lib/patientLookup.ts → the Vercel functions in /api).
# Leave empty when the site itself is served by Vercel (same origin).
# Set it to the Vercel project's URL for the GitHub Pages build and before building the desktop app,
# e.g. VITE_LOOKUP_BASE_URL=https://<project>.vercel.app
VITE_LOOKUP_BASE_URL=

# --- Vercel project environment variables (set in the Vercel dashboard, never in this repo) ---
# EMR_LOOKUP_TOKEN        EMR Viewer's YATA_LOOKUP_TOKEN
# LOOKUP_SESSION_SECRET   32+ random characters, e.g. `openssl rand -hex 32`
# EMR_LOOKUP_URL          optional, default https://emr.codex074.com
# LOOKUP_ALLOWED_ORIGINS  optional, default https://codex074.github.io,http://127.0.0.1:37200
