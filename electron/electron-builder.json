{
  "appId": "th.go.uttaradit.yata",
  "productName": "YATA",
  "copyright": "โรงพยาบาลอุตรดิตถ์ กลุ่มงานเภสัชกรรม",
  "directories": {
    "output": "electron-dist"
  },
  "files": [
    "electron/**",
    "dist/**",
    "!node_modules/**",
    "!src/**",
    "!hn-lookup-electron/**",
    "!scripts/**",
    "!*.ts",
    "!*.config.*",
    "!tsconfig*",
    "!electron/vendor/**",
    "!electron/secrets*.cjs"
  ],
  "extraMetadata": {
    "main": "electron/main.cjs",
    "dependencies": {}
  },
  "win": {
    "icon": "public/icons/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "artifactName": "YATA-Setup-${version}.${ext}",
    "oneClick": false,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "YATA",
    "runAfterFinish": true,
    "installerLanguages": ["th_TH"],
    "language": "1054",
    "license": "electron/license.txt",
    "include": "electron/installer.nsh"
  },
  "portable": {
    "artifactName": "YATA-${version}-portable.exe"
  }
}
